import numpy as np

# 1. Arrays
arr = np.array([10, 20, 30, 40, 50])
print(arr)

# 2. Indexing
arr = np.array([15, 25, 35, 45, 55])
print(arr[2])
print(arr[-1])

# 3. Slicing
arr = np.array([10, 20, 30, 40, 50, 60])
print(arr[1:5])

# 4. Shape
arr = np.array([[1, 2, 3],
                [4, 5, 6]])
print(arr.shape)

# 5. Dimensions
print(arr.ndim)

# 6. Reshaping
arr = np.array([1, 2, 3, 4, 5, 6])
print(arr.reshape(2, 3))

# 7. Broadcasting
arr = np.array([10, 20, 30, 40])
print(arr + 5)

# 8. Vectorization
arr = np.array([1, 2, 3, 4, 5])
print(arr ** 2)

# 9. Matrix Multiplication
a = np.array([[1, 2],
              [3, 4]])

b = np.array([[5, 6],
              [7, 8]])

print(a @ b)

# 10. Mean / Sum / Min / Max
marks = np.array([70, 85, 90, 65, 80])

print("Total:", marks.sum())
print("Average:", marks.mean())
print("Minimum:", marks.min())
print("Maximum:", marks.max())

# 11. Dot Product
a = np.array([2, 3, 4])
b = np.array([5, 2, 1])

print(np.dot(a, b))